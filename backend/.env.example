# Google Gemini API Key
# Get your key from: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL (Neon free tier)
# Get yours from: https://neon.tech — create a project and copy the connection string
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/medease?sslmode=require

# First-run tenant administrator and clinic. The clinic is created only when
# there are no clinics; the admin is created only when there are no admins.
MEDEASE_BOOTSTRAP_ADMIN_USERNAME=
MEDEASE_BOOTSTRAP_ADMIN_PASSWORD=
MEDEASE_BOOTSTRAP_ADMIN_CLINIC_ID=
MEDEASE_BOOTSTRAP_CLINIC_NAME=

# Fictional clinics, doctors, and patients are for local demos only.
MEDEASE_SEED_DEMO_DATA=false

# Set the exact browser origin in production (scheme + host, no path).
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
# COOKIE_SECURE can override the ENVIRONMENT-based default when necessary.

# Optional transactional email. Required for email-based password recovery.
RESEND_API_KEY=
EMAIL_FROM=MedEase <onboarding@resend.dev>

# Stedi Healthcare API (optional - enables real-time eligibility verification)
# Sign up free at https://www.stedi.com  (100 free prod txns/month)
# Without this key, eligibility checks return simulated data.
STEDI_API_KEY=
STEDI_PROVIDER_NPI=1234567893
STEDI_PROVIDER_NAME=MedEase Clinic
STEDI_PROVIDER_ORG=MedEase Health
